generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  departmentId String @id
  name         String

  users      User[]
  requests   Request[]
  categories RequestCategory[]
}

model RequestCategory {
  categoryId   String @id
  name         String
  departmentId String

  department Department @relation(fields: [departmentId], references: [departmentId])
  requests   Request[]
}

model User {
  userId       String @id
  name         String
  email        String @unique
  position     String
  departmentId String

  department    Department     @relation(fields: [departmentId], references: [departmentId])
  requests      Request[]
  approvals     Approval[]
  notifications Notification[]
  comments      Comment[]
}

model Request {
  requestId    String @id
  title        String
  description  String
  status       String
  date         String
  userId       String
  departmentId String
  categoryId   String
  emailUpdates Boolean @default(false)

  user       User             @relation(fields: [userId], references: [userId])
  department Department       @relation(fields: [departmentId], references: [departmentId])
  category   RequestCategory  @relation(fields: [categoryId], references: [categoryId])
  history       RequestHistory[]
  approvals     Approval[]
  notifications Notification[]
  comments      Comment[]

  @@index([userId])
  @@index([departmentId])
  @@index([status])
}

model Approval {
  approvalId   String  @id
  approverId   String
  requestId    String
  decision     String?
  decisionDate String?

  approver User    @relation(fields: [approverId], references: [userId])
  request  Request @relation(fields: [requestId], references: [requestId])

  @@index([approverId])
}

model Notification {
  notificationId String  @id
  userId         String
  requestId      String
  message        String
  createdAt      String
  read           Boolean @default(false)

  user    User    @relation(fields: [userId], references: [userId])
  request Request @relation(fields: [requestId], references: [requestId])

  @@index([userId])
}

model Comment {
  commentId String @id
  requestId String
  userId    String
  message   String
  createdAt String

  request Request @relation(fields: [requestId], references: [requestId])
  user    User    @relation(fields: [userId], references: [userId])

  @@index([requestId])
}

model RequestHistory {
  historyId   String @id
  requestId   String
  status      String
  updatedDate String

  request Request @relation(fields: [requestId], references: [requestId])
}
